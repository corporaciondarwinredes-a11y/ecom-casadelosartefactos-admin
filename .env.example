# ==========================================
# ECOM-ADMIN (SUITE ADMINISTRATIVA & POS CORPORACIÓN DARWIN)
# Variables de Entorno para Producción (Vercel & Supabase)
# ==========================================

# 1. Base de Datos Supabase (PostgreSQL - Misma base compartida)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 2. Autenticación Administrativa NextAuth.js
NEXTAUTH_SECRET="generar-un-token-seguro-con-openssl-rand-base64-32"
NEXTAUTH_URL="https://tu-dominio-admin.com"
NEXT_PUBLIC_APP_URL="https://tu-dominio-admin.com"

# 3. Almacenamiento en la Nube (Vercel Blob Storage - Mismo o compartido)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# 4. Token de Notificaciones en Tiempo Real (Debe coincidir con ecom-cliente)
INTERNAL_API_SECRET="generar-un-token-compartido-entre-ambos-proyectos"
